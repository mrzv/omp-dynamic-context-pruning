{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "omp-dynamic-context-pruning",
  "version": "0.1.0",
  "description": "Dynamic context pruning extension for Oh My Pi",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "DCP contributors and OMP port contributors",
  "keywords": [
    "omp-plugin",
    "omp-extension",
    "dynamic-context-pruning",
    "context",
    "compression"
