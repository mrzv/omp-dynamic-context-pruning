    "@oh-my-pi/pi-tui": ">=17.3.5"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.3.5",
    "@oh-my-pi/pi-tui": "17.3.5",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
