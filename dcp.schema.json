{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/omp-dynamic-context-pruning@latest/dcp.schema.json",
  "title": "OMP Dynamic Context Pruning configuration",
  "description": "A partial DCP configuration layer for OMP.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "enabled": { "type": "boolean", "default": true },
    "debug": { "type": "boolean", "default": false },
    "pruneNotification": {
      "enum": ["off", "minimal", "detailed"],
      "default": "detailed"
    },
    "pruneNotificationType": {
      "enum": ["chat", "toast"],
      "default": "chat"
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "protectedTools": { "$ref": "#/$defs/stringArray" }
      }
    },
    "manualMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "automaticStrategies": { "type": "boolean", "default": true }
      }
    },
    "turnProtection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "turns": { "type": "number", "minimum": 1, "default": 4 }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowSubAgents": { "type": "boolean", "default": false },
        "customPrompts": { "type": "boolean", "default": false }
      }
    },
    "protectedFilePatterns": { "$ref": "#/$defs/stringArray" },
    "compress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["range", "message"], "default": "range" },
        "permission": { "enum": ["ask", "allow", "deny"], "default": "allow" },
        "showCompression": { "type": "boolean", "default": false },
        "summaryBuffer": { "type": "boolean", "default": true },
        "maxContextLimit": { "$ref": "#/$defs/threshold" },
        "minContextLimit": { "$ref": "#/$defs/threshold" },
        "modelMaxLimits": { "$ref": "#/$defs/thresholdMap" },
        "modelMinLimits": { "$ref": "#/$defs/thresholdMap" },
        "nudgeFrequency": { "type": "integer", "minimum": 1, "default": 5 },
        "iterationNudgeThreshold": { "type": "integer", "minimum": 0, "default": 15 },
        "nudgeForce": { "enum": ["strong", "soft"], "default": "soft" },
        "protectedTools": { "$ref": "#/$defs/stringArray" },
        "protectTags": { "type": "boolean", "default": false },
        "protectUserMessages": { "type": "boolean", "default": false }
      }
    },
    "strategies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deduplication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "protectedTools": { "$ref": "#/$defs/stringArray" }
          }
        },
        "purgeErrors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "turns": { "type": "number", "minimum": 1, "default": 4 },
            "protectedTools": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "threshold": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^(?:0*100(?:\\.0+)?|0*(?:[0-9]|[1-9][0-9])(?:\\.\\d+)?)%$" }
      ]
    },
    "thresholdMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/threshold" }
    }
  }
}
